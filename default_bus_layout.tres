[gd_resource type="AudioBusLayout" format=3]

[sub_resource type="AudioEffectLowPassFilter" id="Effect_MusicLowPass"]
resource_name = "LowPassFilter"
cutoff_hz = 700.0

[sub_resource type="AudioEffectCompressor" id="Effect_AnnouncerComp"]
resource_name = "Compressor"
threshold = -12.0
ratio = 3.0

[sub_resource type="AudioEffectReverb" id="Effect_SfxReverb"]
resource_name = "Reverb"
room_size = 0.55
damping = 0.55
spread = 0.8
dry = 1.0
wet = 0.06

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = -4.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("Effect_MusicLowPass")
bus/1/effect/0/enabled = false
bus/2/name = &"Announcer"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("Effect_AnnouncerComp")
bus/2/effect/0/enabled = true
bus/3/name = &"SFX"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Master"
bus/3/effect/0/effect = SubResource("Effect_SfxReverb")
bus/3/effect/0/enabled = true
